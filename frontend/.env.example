# Copy to .env.local. Do not commit real values.
# FastAPI backend address, including /api/v1.
VITE_API_URL=http://localhost:8000/api/v1
# Set to true to use the built-in mock places instead of the backend.
VITE_USE_MOCK_DATA=false
# Mapbox public access token (starts with pk.) from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
