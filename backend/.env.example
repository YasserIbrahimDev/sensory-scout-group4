# LOCAL DEVELOPMENT ONLY. Do not reuse this example password for hosting.
POSTGRES_DB=sensory_scout_diagram
POSTGRES_USER=scout_dev
POSTGRES_PASSWORD=scout_local_only
POSTGRES_PORT=5432

# FastAPI uses the same local database as Compose.
APP_NAME=Sensory Scout API
# Match the LOCAL DEVELOPMENT credentials in the root .env.
# URL-encode special characters if you choose a different password.
DATABASE_URL=postgresql+psycopg://scout_dev:scout_local_only@localhost:5432/sensory_scout_diagram
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
